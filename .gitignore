# Manufacturing Tracker .gitignore
# SECURITY: .env files contain secrets and MUST NOT be committed

# Environment variables - NEVER COMMIT THESE!
.env
.env.local
.env.production
.env.development
.env.test
api/.env
api/.env.local
api/.env.production
web/.env
web/.env.local
web/.env.production
**/.env
**/.env.local
**/.env.production

# Dependencies (downloaded via npm install)
node_modules/
*/node_modules/
api/node_modules/
web/node_modules/

# Build outputs
web/.next/
web/out/
web/build/
dist/
*.tsbuildinfo
next-env.d.ts

# Database files (generated/created by app)
*.db
*.db-journal
*.sqlite
*.sqlite3
api/prisma/dev.db
api/prisma/dev.db-journal
api/prisma/*.db
api/prisma/*.db-journal

# Prisma
api/prisma/migrations/migration_lock.toml
# Keep migrations folder but not the lock file

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
api/logs/
web/logs/

# PM2
.pm2/
pm2.log
pids/
*.pid
*.seed
*.pid.lock

# Testing
coverage/
*.lcov
.nyc_output/

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# IDE - IntelliJ/WebStorm
.idea/
*.iml
*.iws
*.ipr

# IDE - Sublime Text
