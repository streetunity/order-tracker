# Database
DATABASE_URL="file:./dev.db"

# Server
PORT=4000
NODE_ENV=development
SERVER_IP=
CORS_ORIGIN=

# JWT
JWT_SECRET=your-secret-key-here

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=your-bucket-name
S3_BACKUP_BUCKET=your-backup-bucket

# AWS SES (email)
SES_FROM_EMAIL=noreply@yourdomain.com

# NexNP Gateway
# Private key — backend only, NEVER expose in frontend code
NEXTNP_API_KEY=api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Base URL: sandbox or production
NEXTNP_BASE_URL=https://sandbox.nextnpgateway.com
# Processor IDs (from Manage → Processors in NexNP dashboard)
NEXTNP_CARD_PROCESSOR_ID=d49nrd70i4719b5gtq4g
NEXTNP_ACH_PROCESSOR_ID=d72k1gf0i47c3lpoeua0
# Webhook Signature UUID (from Manage → Webhooks in NexNP dashboard)
# Set this after deploying and registering the webhook endpoint
NEXTNP_WEBHOOK_SECRET=
