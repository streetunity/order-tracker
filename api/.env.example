# Order Tracker API Environment Configuration
# Copy this file to .env and fill in your values

DATABASE_URL=file:./dev.db
ADMIN_KEY=dev-admin-key
CORS_ORIGIN=http://localhost:3000
PORT=4000
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars-change-in-production

# AWS S3 Configuration
AWS_REGION=us-east-1
S3_DOCUMENTS_BUCKET=your-documents-bucket-name
S3_BACKUPS_BUCKET=your-backups-bucket-name
MAX_FILE_SIZE=10485760
