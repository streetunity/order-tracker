# Order Tracker API Environment Variables
# INSTRUCTIONS: Copy this file to .env and fill in real values
# This file is a TEMPLATE - it contains no real secrets

# Database
DATABASE_URL=file:./dev.db

# Admin Key (used for admin endpoints)
ADMIN_KEY=change-this-to-secure-random-value

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Server Port
PORT=4000

# JWT Secret (MUST be at least 32 characters for security)
JWT_SECRET=change-this-to-minimum-32-character-random-string-in-production

# AWS Configuration (for S3 storage and backups - add when implementing)
# AWS_REGION=us-east-1
# S3_DOCUMENTS_BUCKET=order-tracker-documents-YOUR-UNIQUE-ID
# S3_BACKUPS_BUCKET=order-tracker-backups-YOUR-UNIQUE-ID
# MAX_FILE_SIZE=10485760

# Email Configuration (optional - for future notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@yourdomain.com

# Zapier/API Configuration (add when implementing)
# API_RATE_LIMIT=100
# API_RATE_WINDOW=900000
