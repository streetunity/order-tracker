datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id             String   @id @default(cuid())
  name           String
  email          String?
  address        String?
  phone          String?
  machineVoltage String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
}

model Order {
  id              String              @id @default(cuid())
  accountId       String
  poNumber        String?
  sku             String?
  orderDate       DateTime?           // NEW FIELD: Actual order date from customer
  customerDocsLink String?            // Customer Documents Link (Dropbox URL)
  internalNotes   String?             // Internal notes for the order
  discount        Float?              @default(0) // Discount amount (stored as positive, calculated as negative)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  etaDate         DateTime?
  currentStage    String              @default("MANUFACTURING")
  trackingToken   String              @unique
  trackingNumber  String?
  shippingCarrier String?
  isLocked        Boolean             @default(false)
  lockedAt        DateTime?
  lockedBy        String?
  createdByUserId String?
  account         Account             @relation(fields: [accountId], references: [id])
  items           OrderItem[]
  statusEvents    OrderStatusEvent[]
  createdBy       User?               @relation(fields: [createdByUserId], references: [id])
}

model OrderItem {
  id             String                  @id @default(cuid())
  orderId        String
  productCode    String
  qty            Int                     @default(1)
  serialNumber   String?
  modelNumber    String?
  voltage        String?
  laserWattage   String?  // Laser Source Wattage
  notes          String?
  
  // MANUFACTURER FIELD - References Manufacturer model
  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  
  // PRICE AND PRIVATE NOTE FIELDS
  itemPrice      Float?   // Price for this item (total, not per unit)
  privateItemNote String? // Private internal notes for this item (purchasing notes)
  
  // ORDERED STATUS FIELDS
  isOrdered      Boolean  @default(false)  // Whether this item has been ordered
  orderedAt      DateTime?                 // When it was marked as ordered
  orderedBy      String?                   // Who marked it as ordered (user name)
  
  // EXTENDED SHIPPING FIELD
  hasExtendedShipping Boolean @default(false) // Whether this item requires extended lead time
  
  // MEASUREMENT FIELDS - Always editable even when order is locked
  height         Float?   // Height dimension
  width          Float?   // Width dimension
  length         Float?   // Length dimension
  weight         Float?   // Weight
  measurementUnit String? @default("in") // "in" or "cm" for dimensions
  weightUnit     String?  @default("lbs") // "lbs" or "kg" for weight
  measuredAt     DateTime? // When measurements were last updated
  measuredBy     String?   // Who took the measurements
  
  // MULTI-CONTAINER SUPPORT - Using String for SQLite compatibility
  containers     String?  @default("[]") // JSON string of container objects
  
  currentStage   String   @default("MANUFACTURING") // FIXED: Added default value and made non-nullable
  archivedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  order          Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  statusEvents   OrderItemStatusEvent[]
  measurementLogs MeasurementAuditLog[]
  
  @@index([manufacturerId])
}

model OrderStatusEvent {
  id               String   @id @default(cuid())
  orderId          String
  stage            String
  note             String?
  createdAt        DateTime @default(now())
  changedByUserId  String?
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy        User?    @relation(fields: [changedByUserId], references: [id])
}

model OrderItemStatusEvent {
  id               String    @id @default(cuid())
  orderItemId      String
  stage            String
  note             String?
  createdAt        DateTime  @default(now())
  changedByUserId  String?
  orderItem        OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  changedBy        User?     @relation(fields: [changedByUserId], references: [id])
}

// Flexible audit log table that can handle any entity type
model AuditLog {
  id                String   @id @default(cuid())
  entityType        String   // "Order", "Account", "User", "OrderItem", "Manufacturer"
  entityId          String   // ID of the entity being audited
  parentEntityId    String?  // Optional: orderId for OrderItems, etc.
  action            String   // "CREATED", "UPDATED", "DELETED", "LOCKED", "ITEM_ORDERED", "ITEM_UNORDERED", etc.
  changes           String?  // JSON string of field changes
  metadata          String?  // JSON string of additional data (reason, notes, etc.)
  performedByUserId String?
  performedByName   String?
  createdAt         DateTime @default(now())
  performedBy       User?    @relation(fields: [performedByUserId], references: [id])
  
  @@index([entityType, entityId])
  @@index([parentEntityId])
  @@index([createdAt])
}

// Measurement-specific audit log for detailed tracking
model MeasurementAuditLog {
  id          String   @id @default(cuid())
  
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  
  // Track which measurement changed
  field       String   // "height", "width", "length", "weight"
  oldValue    Float?
  newValue    Float?
  unit        String?  // Unit at time of measurement
  
  // Who made the change
  performedBy String?
  performedAt DateTime @default(now())
  
  // Link to order for easy queries
  orderId     String
  
  @@index([orderItemId])
  @@index([orderId])
  @@index([performedAt])
  @@index([field])
}

model User {
  id                String                  @id @default(cuid())
  email             String                  @unique
  password          String
  name              String
  role              String                  @default("AGENT") // "SUPER_ADMIN", "ACCOUNTANT", "ADMIN", "AGENT", or "MANUFACTURER"
  isActive          Boolean                 @default(true)
  canBeSalesRep     Boolean                 @default(true)  // NEW: Whether user appears in sales rep dropdown
  lastLogin         DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  createdOrders     Order[]
  statusEvents      OrderStatusEvent[]
  itemStatusEvents  OrderItemStatusEvent[]
  auditLogs         AuditLog[]
  notifications     Notification[]          // Notifications assigned to this user
  manufacturer      Manufacturer?           // Link to manufacturer profile if role is MANUFACTURER
}

// Manufacturer model - represents companies that manufacture items
model Manufacturer {
  id          String      @id @default(cuid())
  name        String      @unique  // Company name
  userId      String?     @unique  // Optional: Link to User account for login
  user        User?       @relation(fields: [userId], references: [id])
  isActive    Boolean     @default(true)
  contactInfo String?     // Contact details
  notes       String?     // Internal notes about the manufacturer
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[] // Items assigned to this manufacturer
  
  @@index([name])
  @@index([isActive])
}

// Stage threshold settings for reports
model StageThreshold {
  id              String   @id @default(cuid())
  stage           String   @unique  // "MANUFACTURING", "TESTING", "SHIPPING", etc.
  warningDays     Int      // Days before warning flag
  criticalDays    Int      // Days before critical flag
  description     String?  // Human-readable description
  updatedAt       DateTime @updatedAt
  updatedBy       String?  // User who last updated
  
  @@index([stage])
}

// System settings for global configurations
model SystemSetting {
  id              String   @id @default(cuid())
  key             String   @unique  // "HOLIDAY_SEASON_START", "HOLIDAY_SEASON_END", etc.
  value           String   // Stored as string, parsed as needed
  description     String?
  updatedAt       DateTime @updatedAt
  updatedBy       String?
  
  @@index([key])
}

// Notification system for alerts and updates
model Notification {
  id              String   @id @default(cuid())
  
  // Who this notification is for
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Notification type and category
  type            String   // "COMMISSION", "ORDER_LATE", "STAGE_WARNING", "STAGE_CRITICAL", "ORDER_DELIVERED", etc.
  category        String   // "COMMISSION", "OPERATIONAL", "ALERT", "INFO"
  
  // Notification content
  title           String
  message         String
  
  // Related entities (optional, for linking)
  relatedOrderId    String?
  relatedItemId     String?
  relatedAccountId  String?
  
  // Metadata (JSON string for flexible data)
  metadata        String?  // JSON: { "amount": 1500, "orderId": "xyz", "daysLate": 5, etc. }
  
  // State tracking
  isRead          Boolean  @default(false)
  readAt          DateTime?
  isDismissed     Boolean  @default(false)
  dismissedAt     DateTime?
  
  // Priority/severity
  priority        String   @default("NORMAL") // "LOW", "NORMAL", "HIGH", "CRITICAL"
  
  // Timestamps
  createdAt       DateTime @default(now())
  expiresAt       DateTime? // Optional: notifications can expire
  
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@index([category])
  @@index([priority])
  @@index([relatedOrderId])
}
