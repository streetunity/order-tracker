datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// COMMISSION MODELS - Sales commission tracking
// ============================================

model Commission {
  id              String @id @default(cuid())
  orderId         String
  salesPersonName String

  orderSubtotal         Float
  orderDiscount         Float @default(0)
  orderNetTotal         Float
  commissionRate        Float
  totalCommissionAmount Float

  status      String
  isFlagged   Boolean @default(false)
  flagReason  String?
  flagDetails String?

  notes String?

  calculatedAt   DateTime?
  lastReviewedAt DateTime?
  lastReviewedBy String?
  reviewNotes    String?

  order           Order?           @relation(fields: [orderId], references: [id])
  itemCommissions ItemCommission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesPersonName])
  @@index([status])
  @@index([orderId])
  @@index([isFlagged])
  @@index([status, createdAt])
  @@index([salesPersonName, status])
  @@index([isFlagged, flagReason])
}

model ItemCommission {
  id           String  @id @default(cuid())
  commissionId String
  itemId       String?
  orderId      String

  productCode String
  qty         Int
  itemPrice   Float

  itemSubtotal       Float
  allocatedDiscount  Float
  discountPercentage Float
  netAmount          Float

  commissionRate   Float
  commissionAmount Float

  status String @default("CALCULATED")

  commission Commission         @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  item       OrderItem?         @relation(fields: [itemId], references: [id], onDelete: SetNull)
  payouts    CommissionPayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commissionId])
  @@index([itemId])
  @@index([orderId])
  @@index([status])
}

model CommissionPayout {
  id               String @id @default(cuid())
  itemCommissionId String
  commissionId     String

  stage      String
  percentage Float
  amount     Float

  status            String
  triggeredByItemId String?
  triggeredAt       DateTime?

  notes String?

  approvedAt       DateTime?
  approvedByUserId String?
  approvedByName   String?
  approvalNotes    String?

  paidAt        DateTime?
  paidByUserId  String?
  paidByName    String?
  paymentNotes  String?
  paymentMethod String?

  rejectedAt       DateTime?
  rejectedByUserId String?
  rejectedByName   String?
  rejectionReason  String?

  itemCommission ItemCommission @relation(fields: [itemCommissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemCommissionId])
  @@index([commissionId])
  @@index([status])
  @@index([stage])
  @@index([status, createdAt])
  @@index([stage, status])
}

model CommissionRate {
  id              String @id @default(cuid())
  salesPersonName String @unique
  rate            Float

  setByUserId String?
  setByName   String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesPersonName])
}

model CommissionStageSetting {
  id         String  @id @default(cuid())
  stage      String  @unique
  percentage Float
  sortOrder  Int
  isActive   Boolean @default(true)

  updatedByUserId String?
  updatedByName   String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([isActive, sortOrder])
}

model CommissionSettings {
  id                String  @id @default(cuid())
  enabled           Boolean @default(true)
  defaultRate       Float   @default(5.0)
  calculationBasis  String  @default("ORDER_TOTAL")
  minimumOrderValue Float   @default(0)

  lastUpdatedBy     String?
  lastUpdatedByName String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

// ============================================
// CORE MODELS
// ============================================

model Account {
  id             String    @id @default(cuid())
  name           String
  contactName    String?
  email          String?
  address        String?
  phone          String?
  machineVoltage String?
  notes          String?

  emailNotifications Boolean @default(false)
  notifyOnStages     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  orders    Order[]
  Customer  Customer?
}

model Order {
  id                     String    @id @default(cuid())
  accountId              String
  poNumber               String?
  sku                    String?
  orderDate              DateTime?
  customerDocsLink       String?
  brokerDocsLink         String?
  internalNotes          String?
  discount               Float?    @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  etaDate                DateTime?
  onsiteInstallationDate DateTime?
  currentStage           String    @default("MANUFACTURING")
  trackingToken          String    @unique
  trackingNumber         String?
  shippingCarrier        String?
  isLocked               Boolean   @default(false)
  lockedAt               DateTime?
  lockedBy               String?
  isArchived             Boolean   @default(false)
  archivedAt             DateTime?
  archivedBy             String?
  createdByUserId        String?

  account           Account            @relation(fields: [accountId], references: [id])
  items             OrderItem[]
  statusEvents      OrderStatusEvent[]
  createdBy         User?              @relation(fields: [createdByUserId], references: [id])
  commissions       Commission[]
  documents         OrderDocument[]
  customerDocuments CustomerDocument[]
  Invoice           Invoice[]
  calendarEvents    CalendarEvent[]
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productCode  String
  qty          Int     @default(1)
  serialNumber String?
  modelNumber  String?
  voltage      String?
  laserWattage String?
  notes        String?

  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])

  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])

  itemPrice       Float?
  privateItemNote String?

  isOrdered Boolean   @default(false)
  orderedAt DateTime?
  orderedBy String?

  hasExtendedShipping Boolean @default(false)

  height          Float?
  width           Float?
  length          Float?
  weight          Float?
  measurementUnit String?   @default("in")
  weightUnit      String?   @default("lbs")
  measuredAt      DateTime?
  measuredBy      String?

  containers String? @default("[]")

  customsDocumentStatus String?   @default("PENDING")
  customsFiledDate      DateTime?
  customsNotes          String?
  brokerNotifiedDate    DateTime?
  brokerLastViewedDate  DateTime?
  customsClearedDate    DateTime?
  billOfLading          String?
  entryNumber           String?

  currentStage       String                 @default("PENDING_FUNDING")
  archivedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  order              Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  statusEvents       OrderItemStatusEvent[]
  measurementLogs    MeasurementAuditLog[]
  itemCommissions    ItemCommission[]
  brokerActivityLogs BrokerActivityLog[]
  documents          ItemDocument[]

  @@index([manufacturerId])
  @@index([orderId])
  @@index([currentStage])
  @@index([customsDocumentStatus])
  @@index([shipmentId])
}

model Shipment {
  id String @id @default(cuid())

  containerNumber String?
  billOfLading    String?

  etaDate           DateTime?
  vesselName        String?
  portOfOrigin      String?
  portOfDestination String?

  customsDocumentStatus String    @default("PENDING")
  customsFiledDate      DateTime?
  customsClearedDate    DateTime?
  customsNotes          String?

  archivedAt DateTime?
  archivedBy String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  createdByName   String?

  items        OrderItem[]
  documents    ShipmentDocument[]
  activityLogs ShipmentActivityLog[]

  @@index([containerNumber])
  @@index([billOfLading])
  @@index([customsDocumentStatus])
  @@index([archivedAt])
}

model ShipmentDocument {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  fileName     String
  fileSize     Int
  fileType     String
  documentType String
  s3Key        String
  s3Url        String

  uploadedBy String
  uploadedAt DateTime @default(now())

  @@index([shipmentId])
  @@index([documentType])
  @@map("shipment_documents")
}

model ShipmentActivityLog {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  userId     String
  userName   String
  action     String
  oldStatus  String?
  newStatus  String?
  notes      String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([shipmentId])
  @@index([createdAt])
  @@index([action])
  @@map("shipment_activity_logs")
}

model OrderStatusEvent {
  id              String   @id @default(cuid())
  orderId         String
  stage           String
  note            String?
  createdAt       DateTime @default(now())
  changedByUserId String?
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy       User?    @relation(fields: [changedByUserId], references: [id])
}

model OrderItemStatusEvent {
  id              String    @id @default(cuid())
  orderItemId     String
  stage           String
  note            String?
  createdAt       DateTime  @default(now())
  changedByUserId String?
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  changedBy       User?     @relation(fields: [changedByUserId], references: [id])
}

model AuditLog {
  id                String   @id @default(cuid())
  entityType        String
  entityId          String
  parentEntityId    String?
  action            String
  changes           String?
  metadata          String?
  performedByUserId String?
  performedByName   String?
  createdAt         DateTime @default(now())
  performedBy       User?    @relation(fields: [performedByUserId], references: [id])

  @@index([entityType, entityId])
  @@index([parentEntityId])
  @@index([createdAt])
}

model MeasurementAuditLog {
  id String @id @default(cuid())

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  field    String
  oldValue Float?
  newValue Float?
  unit     String?

  performedBy String?
  performedAt DateTime @default(now())

  orderId String

  @@index([orderItemId])
  @@index([orderId])
  @@index([performedAt])
  @@index([field])
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  password               String
  name                   String
  role                   String                 @default("AGENT")
  isActive               Boolean                @default(true)
  isEmployee             Boolean                @default(true)  // False for system/service accounts (cron jobs, sysop, etc.)
  showInSalesRepDropdown Boolean                @default(true)
  lastLogin              DateTime?
  icsToken               String?                @unique
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  createdOrders          Order[]
  statusEvents           OrderStatusEvent[]
  itemStatusEvents       OrderItemStatusEvent[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  manufacturer           Manufacturer?
  brokerActivityLogs     BrokerActivityLog[]
  customerDocuments      CustomerDocument[]
  globalDocuments        GlobalCustomerDocument[]

  calendarEventsAsSubject CalendarEvent[] @relation("CalendarEventUser")
  calendarEventsCreated   CalendarEvent[] @relation("CalendarEventCreatedBy")

  assignedLeads            Lead[]             @relation("LeadAssignedTo")
  deletedLeads             Lead[]             @relation("LeadDeletedBy")
  assignedCustomers        Customer[]         @relation("CustomerAssignedTo")
  deletedCustomers         Customer[]         @relation("CustomerDeletedBy")
  createdEstimates         Estimate[]         @relation("EstimateCreatedBy")
  deletedEstimates         Estimate[]         @relation("EstimateDeletedBy")
  createdInvoices          Invoice[]          @relation("InvoiceCreatedBy")
  deletedInvoices          Invoice[]          @relation("InvoiceDeletedBy")
  createdRecurringInvoices RecurringInvoice[]
  Payment                  Payment[]
  EmailLog                 EmailLog[]
  UserEmailSettings        UserEmailSettings?
  CreditMemo               CreditMemo[]
  comments                 Comment[]          @relation("CommentAuthor")
  assignedReminders        Reminder[]         @relation("ReminderAssignedTo")
  createdReminders         Reminder[]         @relation("ReminderCreatedBy")

  @@index([role])
  @@index([isActive])
  @@index([isEmployee])
  @@index([showInSalesRepDropdown])
}

model Manufacturer {
  id          String      @id @default(cuid())
  name        String      @unique
  userId      String?     @unique
  user        User?       @relation(fields: [userId], references: [id])
  isActive    Boolean     @default(true)
  contactInfo String?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@index([name])
  @@index([isActive])
}

model StageThreshold {
  id           String   @id @default(cuid())
  stage        String   @unique
  warningDays  Int
  criticalDays Int
  description  String?
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  @@index([stage])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([key])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     String
  category String

  title   String
  message String

  relatedOrderId   String?
  relatedItemId    String?
  relatedAccountId String?

  metadata String?

  isRead      Boolean   @default(false)
  readAt      DateTime?
  isDismissed Boolean   @default(false)
  dismissedAt DateTime?

  priority String @default("NORMAL")

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@index([category])
  @@index([priority])
  @@index([relatedOrderId])
}

model BrokerActivityLog {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  action      String
  oldStatus   String?
  newStatus   String?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([orderItemId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model OrderDocument {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fileName String
  fileSize Int
  fileType String
  s3Key    String
  s3Url    String

  uploadedBy String
  uploadedAt DateTime @default(now())

  @@index([orderId])
  @@map("order_documents")
}

model ItemDocument {
  id     String    @id @default(cuid())
  itemId String
  item   OrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  fileName     String
  fileSize     Int
  fileType     String
  documentType String
  s3Key        String
  s3Url        String

  uploadedBy String
  uploadedAt DateTime @default(now())

  @@index([itemId])
  @@index([documentType])
  @@map("item_documents")
}

model CustomerDocument {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fileName String
  fileSize BigInt
  mimeType String

  s3Bucket String
  s3Key    String

  description String?

  category    String  @default("documents")
  sortOrder   Int     @default(0)
  displayName String?

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  uploadId   String?
  isComplete Boolean @default(false)

  expiresAt DateTime

  @@index([orderId])
  @@index([orderId, category])
  @@index([uploadedById])
  @@index([isComplete])
  @@index([expiresAt])
  @@map("customer_documents")
}

// ============================================
// GLOBAL CUSTOMER DOCUMENTS (Read Me Files)
// Uploaded once in settings, appear in every customer order's files page.
// ============================================

model GlobalCustomerDocument {
  id          String   @id @default(cuid())
  fileName    String
  displayName String?
  fileSize    BigInt
  mimeType    String
  s3Bucket    String
  s3Key       String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  uploadId   String?
  isComplete Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isComplete])
  @@index([uploadedById])
  @@map("global_customer_documents")
}

// ============================================
// CALENDAR EVENTS
// ============================================

model CalendarEvent {
  id        String   @id @default(cuid())
  type      String   // INSTALL | TIME_OFF | BLOCKED | OTHER
  title     String
  startDate DateTime
  endDate   DateTime
  allDay    Boolean  @default(true)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation("CalendarEventUser", fields: [userId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("CalendarEventCreatedBy", fields: [createdById], references: [id])

  notes            String?
  customerNotified Boolean @default(false)
  assigneeIds      String? @default("[]") // JSON array of user IDs assigned to INSTALL events

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([startDate])
  @@index([endDate])
  @@index([orderId])
  @@index([userId])
  @@index([createdById])
  @@index([startDate, endDate])
}

model Lead {
  id String @id @default(cuid())

  source          String  @default("manual")
  sourceDetails   String?
  zapierWebhookId String?

  firstName String
  lastName  String
  email     String
  phone     String?
  company   String?

  address String?
  city    String?
  state   String?
  zipCode String?
  country String? @default("USA")

  interestedIn String?
  notes        String?
  budget       Float?
  timeline     String?

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignedTo", fields: [assignedToId], references: [id])

  status     String  @default("NEW")
  lostReason String?

  convertedToCustomerId String?   @unique
  convertedToCustomer   Customer? @relation(fields: [convertedToCustomerId], references: [id])
  convertedAt           DateTime?
  convertedById         String?

  followUpDate  DateTime?
  followUpNotes String?
  lastContactAt DateTime?

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("LeadDeletedBy", fields: [deletedById], references: [id])

  activities CustomerActivityLog[]
  reminders  Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([assignedToId])
  @@index([source])
  @@index([createdAt])
  @@index([convertedToCustomerId])
  @@index([followUpDate])
}

model Customer {
  id             String @id @default(cuid())
  customerNumber String @unique

  companyName String?

  firstName String
  lastName  String
  email     String
  phone     String?
  company   String?

  billingAddress String?
  billingCity    String?
  billingState   String?
  billingZipCode String?
  billingCountry String? @default("USA")

  shippingAddress         String?
  shippingCity            String?
  shippingState           String?
  shippingZipCode         String?
  shippingCountry         String?
  shippingSameAsBilling   Boolean @default(true)
  sameAsBilling           Boolean @default(true)

  taxExempt           Boolean @default(false)
  taxExemptId         String?
  creditLimit         Float?
  defaultPaymentTerms String  @default("NET30")
  paymentTerms        String? @default("NET30")

  stripeCustomerId String? @unique

  primaryContactId String?
  assignedToId     String?
  assignedTo       User?   @relation("CustomerAssignedTo", fields: [assignedToId], references: [id])

  leadId String? @unique
  lead   Lead?

  portalToken       String?  @unique
  portalTokenExpiry DateTime?
  portalEnabled     Boolean  @default(true)

  tags String?

  status        String  @default("ACTIVE")
  notes         String?
  internalNotes String?

  accountId String?  @unique
  account   Account? @relation(fields: [accountId], references: [id])

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("CustomerDeletedBy", fields: [deletedById], references: [id])

  contacts          CustomerContact[]
  estimates         Estimate[]
  invoices          Invoice[]
  payments          Payment[]
  creditMemos       CreditMemo[]
  recurringInvoices RecurringInvoice[]
  activities        CustomerActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([customerNumber])
  @@index([assignedToId])
  @@index([status])
  @@index([company])
  @@index([companyName])
  @@index([createdAt])
  @@index([accountId])
  @@index([leadId])
  @@index([stripeCustomerId])
  @@index([portalToken])
}

model Estimate {
  id             String @id @default(cuid())
  estimateNumber String @unique

  version          Int       @default(1)
  parentEstimateId String?
  parentEstimate   Estimate? @relation("EstimateVersions", fields: [parentEstimateId], references: [id])
  revisions        Estimate[] @relation("EstimateVersions")

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  estimateDate   DateTime @default(now())
  expirationDate DateTime?
  expiryDate     DateTime

  subtotal       Float
  discountType   String?
  discountValue  Float?
  discountAmount Float   @default(0)
  taxRate        Float   @default(0)
  taxAmount      Float   @default(0)
  shippingAmount Float   @default(0)
  total          Float

  totalCost     Float?
  marginAmount  Float?
  marginPercent Float?

  status String @default("DRAFT")

  outcome       String?
  outcomeReason String?
  outcomeNotes  String?
  outcomeDate   DateTime?

  notes           String?
  internalNotes   String?
  termsConditions String?

  pdfS3Key       String?
  pdfUrl         String?
  pdfGeneratedAt DateTime?

  signatureId     String?    @unique
  signature       Signature? @relation(fields: [signatureId], references: [id])
  signedPdfS3Key  String?

  lastSentAt   DateTime?
  lastViewedAt DateTime?
  viewCount    Int       @default(0)
  sentCount    Int       @default(0)

  assignedToId String?

  requiresApproval Boolean   @default(false)
  approvalStatus   String?
  approvedById     String?
  approvedAt       DateTime?
  approvalNotes    String?

  isTemplate   Boolean @default(false)
  templateName String?
  clonedFromId String?

  convertedToInvoiceId String?   @unique
  convertedAt          DateTime?

  followUpDate  DateTime?
  followUpNotes String?

  createdById String
  createdBy   User   @relation("EstimateCreatedBy", fields: [createdById], references: [id])

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("EstimateDeletedBy", fields: [deletedById], references: [id])

  items      EstimateItem[]
  invoices   Invoice[]
  emailLogs  EmailLog[]
  comments   Comment[]
  activities CustomerActivityLog[]
  reminders  Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estimateNumber])
  @@index([customerId])
  @@index([status])
  @@index([estimateDate])
  @@index([expiryDate])
  @@index([expirationDate])
  @@index([createdById])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([convertedToInvoiceId])
  @@index([parentEstimateId])
  @@index([outcome])
  @@index([followUpDate])
}

model EstimateItem {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  productId String?

  fromBundleId   String?
  fromBundleName String?

  name        String
  description String?
  sku         String?

  quantity  Float
  unitPrice Float
  unitCost  Float?
  amount    Float

  discountType   String?
  discountValue  Float?
  discountAmount Float   @default(0)

  taxable      Boolean @default(true)
  measurements String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estimateId])
  @@index([productId])
}

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  estimateId String?
  estimate   Estimate? @relation(fields: [estimateId], references: [id])

  invoiceDate DateTime @default(now())
  dueDate     DateTime

  paymentTerms String @default("NET30")

  subtotal       Float
  discountType   String?
  discountValue  Float?
  discountAmount Float   @default(0)
  taxRate        Float   @default(0)
  taxAmount      Float   @default(0)
  shippingAmount Float   @default(0)
  total          Float
  amountPaid     Float   @default(0)
  balanceDue     Float

  totalCost     Float?
  marginAmount  Float?
  marginPercent Float?

  paymentType     String  @default("FULL")
  depositRequired Float?
  depositPaid     Boolean @default(false)

  paymentScheduleType String?

  status String @default("DRAFT")

  notes           String?
  internalNotes   String?
  termsConditions String?

  pdfS3Key       String?
  pdfUrl         String?
  pdfGeneratedAt DateTime?

  lastSentAt   DateTime?
  lastViewedAt DateTime?
  viewCount    Int       @default(0)
  sentCount    Int       @default(0)

  assignedToId String?

  orderCreationTrigger String @default("DEPOSIT")

  convertedToOrderId String?   @unique
  convertedToOrder   Boolean   @default(false)
  orderId            String?
  order              Order?    @relation(fields: [orderId], references: [id])
  convertedAt        DateTime?

  createdById String
  createdBy   User   @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  metadata String?

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("InvoiceDeletedBy", fields: [deletedById], references: [id])

  items              InvoiceItem[]
  payments           Payment[]
  paymentSchedule    InvoicePaymentSchedule[]
  emailLogs          EmailLog[]
  creditMemos        CreditMemo[]
  comments           Comment[]
  activities         CustomerActivityLog[]
  reminders          Reminder[]
  recurringInvoiceId String?
  recurringInvoice   RecurringInvoice? @relation("GeneratedFromRecurring", fields: [recurringInvoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currency      String @default("USD")
  exchangeRate  Float?
  subtotalLocal Float?
  totalLocal    Float?

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([status])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([createdById])
  @@index([assignedToId])
  @@index([estimateId])
  @@index([orderId])
  @@index([createdAt])
  @@index([convertedToOrder])
  @@index([depositPaid])
  @@index([paymentScheduleType])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?

  name        String
  description String?
  sku         String?

  quantity  Float
  unitPrice Float
  unitCost  Float?
  amount    Float

  taxable      Boolean @default(true)
  measurements String?

  orderItemId String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id            String @id @default(cuid())
  paymentNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  scheduleItemId String?
  scheduleIndex  Int?

  amount Float

  paymentDate   DateTime @default(now())
  paymentMethod String

  nextnpTransactionId String?

  stripePaymentIntentId String?
  stripeChargeId        String?

  last4     String?
  cardBrand String?
  bankName  String?

  checkNumber     String?
  wireReference   String?
  referenceNumber String?

  status String @default("PENDING")

  refundedAmount Float?
  refundedAt     DateTime?
  refundReason   String?

  notes String?

  recordedById String?
  recordedBy   User?   @relation(fields: [recordedById], references: [id])

  activities CustomerActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentNumber])
  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
  @@index([paymentDate])
  @@index([paymentMethod])
  @@index([recordedById])
  @@index([nextnpTransactionId])
  @@index([stripePaymentIntentId])
  @@index([scheduleItemId])
}

model EmailLog {
  id String @id @default(cuid())

  invoiceId  String?
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id])
  estimateId String?
  estimate   Estimate? @relation(fields: [estimateId], references: [id])

  fromEmail String
  toEmail   String
