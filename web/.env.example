# Next.js public environment variables (safe to expose to browser)

# NexNP Tokenizer — public key only, never the private key
NEXT_PUBLIC_NEXTNP_PUBLIC_KEY=pub_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_NEXTNP_BASE_URL=https://sandbox.nextnpgateway.com

# API URL (leave empty for same-origin proxy)
NEXT_PUBLIC_API_URL=
